NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
CORS_ORIGINS=*

# Corridor to simulate (the whole country is too big). Stations between FROM and TO are discovered automatically.
SCOPE_FROM=DDN
SCOPE_TO=SRE
# Or list the station codes yourself (overrides FROM/TO), e.g. DDN,HW,RK,SRE
SCOPE_STATIONS=
# A section used by at least this many trains is treated as double track
DOUBLE_TRACK_MIN_TRAINS=15
# Cap on trains loaded (keeps the optimizer fast)
MAX_TRAINS=120
